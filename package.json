{
  "name": "webcard-site",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "description": "A portable Webcard gallery generated as static HTML with Vite.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-site.js",
    "preview": "vite preview",
    "card:add": "node scripts/add-webcard.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node --test tests/browser/*.test.js",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build",
    "template:manifest": "node scripts/template-manifest.js",
    "template:init": "node scripts/init-instance.js",
    "template:test": "node scripts/test-template.js"
  },
  "engines": {
    "node": ">=24.8.0 <25"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cheerio": "1.2.0",
    "ipaddr.js": "2.5.0",
    "jsonc-parser": "3.3.1",
    "sharp": "0.35.5",
    "undici": "8.11.2",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "eslint": "10.12.0",
    "knitto": "0.3.0",
    "knitto-gh": "0.2.4",
    "playwright": "1.64.0",
    "vite": "8.3.3"
  }
}
